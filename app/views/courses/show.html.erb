<% content_for :title, @course.title %>

<div class="page-header">
  <div>
    <p class="page-eyebrow">Course</p>
    <h1 class="h2 mb-2"><%= @course.title %></h1>
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <%= status_badge(@course.status) %>
      <span class="text-muted small">for <%= link_to @course.subject.name, @course.subject, class: "text-decoration-none" %></span>
    </div>
  </div>
  <div class="d-flex gap-2">
    <%= link_to edit_course_path(@course), class: "btn btn-outline-secondary" do %>
      <i class="bi bi-pencil me-1"></i>Edit
    <% end %>
    <%= button_to @course, method: :delete, class: "btn btn-outline-danger", form: { data: { turbo_confirm: "Delete this course?" } } do %>
      <i class="bi bi-trash3 me-1"></i>Delete
    <% end %>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <dl class="row mb-0">
      <% if @course.provider.present? %>
        <dt class="col-sm-3 text-muted small text-uppercase fw-semibold">Provider</dt>
        <dd class="col-sm-9"><%= @course.provider %></dd>
      <% end %>

      <% if @course.url.present? %>
        <dt class="col-sm-3 text-muted small text-uppercase fw-semibold">URL</dt>
        <dd class="col-sm-9"><%= link_to @course.url, @course.url, target: "_blank", rel: "noopener" %></dd>
      <% end %>

      <% if @course.level.present? %>
        <dt class="col-sm-3 text-muted small text-uppercase fw-semibold">Level</dt>
        <dd class="col-sm-9"><%= @course.level %></dd>
      <% end %>

      <% if @course.roadmap_position.present? %>
        <dt class="col-sm-3 text-muted small text-uppercase fw-semibold">Roadmap step</dt>
        <dd class="col-sm-9">Step <%= @course.roadmap_position %></dd>
      <% end %>

      <% if @course.purpose.present? %>
        <dt class="col-sm-3 text-muted small text-uppercase fw-semibold">Purpose</dt>
        <dd class="col-sm-9"><%= @course.purpose %></dd>
      <% end %>

      <% if @course.progress_percentage.present? %>
        <dt class="col-sm-3 text-muted small text-uppercase fw-semibold">Progress</dt>
        <dd class="col-sm-9">
          <div class="progress mb-1" style="height: 8px; max-width: 320px;">
            <div class="progress-bar" role="progressbar" style="width: <%= @course.progress_percentage %>%;"></div>
          </div>
          <span class="small text-muted"><%= @course.progress_percentage %>% complete</span>
        </dd>
      <% end %>
    </dl>
  </div>
</div>

<% if @course.notes.present? %>
  <div class="alert alert-light border mt-3">
    <strong>Notes:</strong> <%= @course.notes %>
  </div>
<% end %>

<p class="mt-4">
  <%= link_to courses_path, class: "btn btn-link ps-0" do %>
    <i class="bi bi-arrow-left me-1"></i>Back to Courses
  <% end %>
</p>
