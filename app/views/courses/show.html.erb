<% content_for :title, @course.title %>

<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <h1 class="h3 mb-1"><%= @course.title %></h1>
    <%= status_badge(@course.status) %>
    <span class="text-muted">for <%= link_to @course.subject.name, @course.subject, class: "text-decoration-none" %></span>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Edit", edit_course_path(@course), class: "btn btn-outline-secondary" %>
    <%= button_to "Delete", @course, method: :delete, class: "btn btn-outline-danger", form: { data: { turbo_confirm: "Delete this course?" } } %>
  </div>
</div>

<dl class="row">
  <% if @course.provider.present? %>
    <dt class="col-sm-3">Provider</dt>
    <dd class="col-sm-9"><%= @course.provider %></dd>
  <% end %>

  <% if @course.url.present? %>
    <dt class="col-sm-3">URL</dt>
    <dd class="col-sm-9"><%= link_to @course.url, @course.url, target: "_blank", rel: "noopener" %></dd>
  <% end %>

  <% if @course.level.present? %>
    <dt class="col-sm-3">Level</dt>
    <dd class="col-sm-9"><%= @course.level %></dd>
  <% end %>

  <% if @course.progress_percentage.present? %>
    <dt class="col-sm-3">Progress</dt>
    <dd class="col-sm-9">
      <div class="progress" style="height: 10px;">
        <div class="progress-bar" role="progressbar" style="width: <%= @course.progress_percentage %>%;"></div>
      </div>
      <span class="small text-muted"><%= @course.progress_percentage %>% complete</span>
    </dd>
  <% end %>
</dl>

<% if @course.notes.present? %>
  <div class="alert alert-light border">
    <strong>Notes:</strong> <%= @course.notes %>
  </div>
<% end %>

<p class="mt-3">
  <%= link_to "← Back to Courses", courses_path, class: "btn btn-link ps-0" %>
</p>
