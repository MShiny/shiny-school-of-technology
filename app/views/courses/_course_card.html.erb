<%
show_progress = local_assigns.fetch(:show_progress, true)
show_roadmap_position = local_assigns.fetch(:show_roadmap_position, false)
%>
<div class="card h-100">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start">
      <h3 class="card-title h6 mb-1"><%= link_to course.title, course, class: "text-decoration-none" %></h3>
      <div class="d-flex align-items-center gap-1">
        <% if show_roadmap_position && course.roadmap_position.present? %>
          <span class="badge text-bg-secondary rounded-pill">Step <%= course.roadmap_position %></span>
        <% end %>
        <%= status_badge(course.status) %>
      </div>
    </div>
    <p class="card-text small text-muted mb-1">
      <%= link_to course.subject.name, course.subject, class: "text-decoration-none" %>
      <% if course.provider.present? %> · <%= course.provider %><% end %>
      <% if course.level.present? %> · Level <%= course.level %><% end %>
    </p>
    <% if course.purpose.present? %>
      <p class="card-text small text-muted mb-1"><em>🎯 <%= course.purpose %></em></p>
    <% end %>
    <% if show_progress && course.progress_percentage.present? %>
      <div class="progress" style="height: 6px;">
        <div class="progress-bar" role="progressbar" style="width: <%= course.progress_percentage %>%;" aria-valuenow="<%= course.progress_percentage %>" aria-valuemin="0" aria-valuemax="100"></div>
      </div>
      <p class="small text-muted mt-1 mb-0"><%= course.progress_percentage %>% complete</p>
    <% end %>
  </div>
</div>
