<% content_for :title, "Courses" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">🧑‍💻 Courses</h1>
  <%= link_to "New Course", new_course_path, class: "btn btn-primary" %>
</div>

<ul class="nav nav-pills mb-3">
  <li class="nav-item">
    <%= link_to "All", courses_path, class: "nav-link #{'active' if @status_filter.blank?}" %>
  </li>
  <% Course.statuses.keys.each do |status| %>
    <li class="nav-item">
      <%= link_to status.humanize, courses_path(status: status), class: "nav-link #{'active' if @status_filter == status}" %>
    </li>
  <% end %>
</ul>

<% if @courses.any? %>
  <div class="row g-3">
    <% @courses.each do |course| %>
      <div class="col-md-6 col-lg-4">
        <%= render "course_card", course: course %>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-muted">
    <% if @status_filter.present? %>
      No courses with status "<%= @status_filter.humanize %>" yet.
    <% else %>
      No courses yet. Add a course or resource you're using for a subject.
    <% end %>
  </p>
<% end %>
