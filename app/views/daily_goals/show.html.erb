<% content_for :title, "Daily Goal - #{@daily_goal.date.strftime('%b %-d, %Y')}" %>

<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <h1 class="h3 mb-1"><%= @daily_goal.date.strftime("%A, %B %-d, %Y") %></h1>
    <%= status_badge(@daily_goal.status) %>
  </div>
  <%= link_to "Edit Notes", edit_daily_goal_path(@daily_goal), class: "btn btn-outline-secondary" %>
</div>

<%= render "daily_goal_items/checklist", daily_goal: @daily_goal, editable: @daily_goal.date == Date.current %>

<% if @daily_goal.notes.present? %>
  <div class="alert alert-light border mt-3">
    <strong>Notes:</strong> <%= @daily_goal.notes %>
  </div>
<% end %>

<p class="mt-4">
  <%= link_to "← Back to Daily Goals", daily_goals_path, class: "btn btn-link ps-0" %>
</p>
