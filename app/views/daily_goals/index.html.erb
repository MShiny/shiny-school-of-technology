<% content_for :title, "Daily Goals" %>

<div class="page-header">
  <div>
    <p class="page-eyebrow">Planner</p>
    <h1 class="h2"><%= @month.strftime("%B %Y") %></h1>
    <p class="text-muted mb-0">Plan ahead, check in today, and look back at what got done.</p>
  </div>
  <%= link_to history_daily_goals_path, class: "btn btn-outline-secondary btn-sm" do %>
    <i class="bi bi-list-ul me-1"></i>History
  <% end %>
</div>

<div class="calendar-nav">
  <%= link_to daily_goals_path(month: @previous_month.strftime("%Y-%m")), class: "btn btn-outline-secondary btn-sm", aria: { label: "Previous month" } do %>
    <i class="bi bi-chevron-left"></i> Previous
  <% end %>
  <%= link_to "Today", daily_goals_path, class: "btn btn-sm btn-primary" %>
  <%= link_to daily_goals_path(month: @next_month.strftime("%Y-%m")), class: "btn btn-outline-secondary btn-sm", aria: { label: "Next month" } do %>
    Next <i class="bi bi-chevron-right"></i>
  <% end %>
</div>

<div class="calendar-legend">
  <span><span class="status-dot status-success"></span> Met</span>
  <span><span class="status-dot status-warning"></span> Partial</span>
  <span><span class="status-dot status-danger"></span> Not met</span>
  <span><span class="status-dot status-accent"></span> Planned</span>
</div>

<div class="calendar-scroll">
  <div class="calendar-grid">
    <% %w[Mon Tue Wed Thu Fri Sat Sun].each do |label| %>
      <div class="calendar-weekday"><%= label %></div>
    <% end %>

    <% @calendar_weeks.each do |week| %>
      <% week.each do |day| %>
        <%= render "calendar_day", day: day %>
      <% end %>
    <% end %>
  </div>
</div>
