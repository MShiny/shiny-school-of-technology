<% content_for :title, "Daily Goals" %>

<h1 class="h3 mb-3">🗓️ Daily Goals</h1>

<% if @daily_goals.any? %>
  <div class="list-group">
    <% @daily_goals.each do |goal| %>
      <%= link_to daily_goal_path(goal), class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>
        <span>
          <strong><%= goal.date.strftime("%b %-d, %Y") %></strong>
          <span class="text-muted ms-2"><%= truncate(goal.goal_text, length: 60) %></span>
        </span>
        <%= status_badge(goal.status) %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <p class="text-muted">No daily goals recorded yet.</p>
<% end %>
