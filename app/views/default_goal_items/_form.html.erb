<%= form_with model: default_goal_item, class: "form-card" do |form| %>
  <%= render "shared/form_errors", object: default_goal_item %>

  <div class="form-section">
    <div class="mb-3">
      <%= form.label :text, "Item text", class: "form-label" %>
      <%= form.text_field :text, class: "form-control" %>
    </div>

    <div class="row">
      <div class="col-md-6 mb-3 mb-md-0">
        <%= form.label :position, class: "form-label" %>
        <%= form.number_field :position, class: "form-control", min: 0 %>
      </div>
      <div class="col-md-6 d-flex align-items-center">
        <div class="form-check mt-4">
          <%= form.check_box :active, class: "form-check-input" %>
          <%= form.label :active, class: "form-check-label" %>
        </div>
      </div>
    </div>
  </div>

  <div class="form-section">
    <p class="form-section-title mb-2">Repeat</p>
    <div class="form-check mb-2">
      <%= form.check_box :daily, class: "form-check-input" %>
      <%= form.label :daily, "Every day", class: "form-check-label" %>
    </div>
    <div class="weekday-picker">
      <%= hidden_field_tag "default_goal_item[weekdays][]", "" %>
      <% DefaultGoalItem::WEEKDAY_OPTIONS.each do |value, label| %>
        <label class="weekday-chip">
          <%= check_box_tag "default_goal_item[weekdays][]", value, default_goal_item.weekdays.include?(value), class: "weekday-chip-input" %>
          <%= label %>
        </label>
      <% end %>
    </div>
    <div class="form-text">Choose "Every day", or pick one or more weekdays instead.</div>
  </div>

  <div class="d-flex gap-2 mt-4">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", default_goal_items_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
