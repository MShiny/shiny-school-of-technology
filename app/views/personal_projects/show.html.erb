<% content_for :title, @personal_project.name %>

<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <h1 class="h3 mb-1"><%= @personal_project.name %></h1>
    <%= status_badge(@personal_project.status) %>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Edit", edit_personal_project_path(@personal_project), class: "btn btn-outline-secondary" %>
    <%= button_to "Delete", @personal_project, method: :delete, class: "btn btn-outline-danger", form: { data: { turbo_confirm: "Delete this project?" } } %>
  </div>
</div>

<% if @personal_project.goal.present? %>
  <div class="alert alert-light border">
    <strong>🎯 Goal:</strong> <%= @personal_project.goal %>
  </div>
<% end %>

<% if @personal_project.description.present? %>
  <p class="lead"><%= @personal_project.description %></p>
<% end %>

<% if @personal_project.target_date.present? %>
  <p><strong>Target date:</strong> <%= @personal_project.target_date.strftime("%A, %B %-d, %Y") %></p>
<% end %>

<h2 class="h5 mt-4">Subjects</h2>
<% if @subjects.any? %>
  <div class="row g-2">
    <% @subjects.each do |subject| %>
      <div class="col-md-6 col-lg-4">
        <div class="card">
          <div class="card-body d-flex justify-content-between align-items-center">
            <%= link_to subject.name, subject, class: "text-decoration-none fw-semibold" %>
            <%= status_badge(subject.status) %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-muted">No subjects linked to this project yet.</p>
<% end %>

<% if @personal_project.notes.present? %>
  <div class="alert alert-light border mt-3">
    <strong>Notes:</strong> <%= @personal_project.notes %>
  </div>
<% end %>

<p class="mt-3">
  <%= link_to "← Back to Personal Projects", personal_projects_path, class: "btn btn-link ps-0" %>
</p>
