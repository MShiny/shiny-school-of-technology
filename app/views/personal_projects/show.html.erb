<% content_for :title, @personal_project.name %>

<div class="page-header">
  <div>
    <p class="page-eyebrow">Personal Project</p>
    <h1 class="h2 mb-2"><%= @personal_project.name %></h1>
    <%= status_badge(@personal_project.status) %>
  </div>
  <div class="d-flex gap-2">
    <%= link_to edit_personal_project_path(@personal_project), class: "btn btn-outline-secondary" do %>
      <i class="bi bi-pencil me-1"></i>Edit
    <% end %>
    <%= button_to @personal_project, method: :delete, class: "btn btn-outline-danger", form: { data: { turbo_confirm: "Delete this project?" } } do %>
      <i class="bi bi-trash3 me-1"></i>Delete
    <% end %>
  </div>
</div>

<div class="card project-card mb-3">
  <div class="card-body">
    <% if @personal_project.goal.present? %>
      <p class="mb-2"><i class="bi bi-bullseye me-1 text-muted"></i><strong>Goal:</strong> <%= @personal_project.goal %></p>
    <% end %>

    <% if @personal_project.description.present? %>
      <p class="text-muted mb-2"><%= @personal_project.description %></p>
    <% end %>

    <% if @personal_project.target_date.present? %>
      <p class="mb-0 small text-muted"><i class="bi bi-flag me-1"></i>Target date: <%= @personal_project.target_date.strftime("%A, %B %-d, %Y") %></p>
    <% end %>
  </div>
</div>

<div class="section-heading">
  <h2><i class="bi bi-journal-bookmark text-muted"></i> Related Subjects</h2>
</div>
<% if @subjects.any? %>
  <div class="row g-2 mb-3">
    <% @subjects.each do |subject| %>
      <div class="col-md-6 col-lg-4">
        <%= link_to subject, class: "card h-100 text-decoration-none text-body" do %>
          <div class="card-body py-3 d-flex justify-content-between align-items-center">
            <span class="fw-semibold"><%= subject.name %></span>
            <%= status_badge(subject.status) %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="empty-state empty-state-inline">No subjects linked to this project yet.</div>
<% end %>

<% if @personal_project.notes.present? %>
  <div class="alert alert-light border mt-3">
    <strong>Notes:</strong> <%= @personal_project.notes %>
  </div>
<% end %>

<p class="mt-4">
  <%= link_to personal_projects_path, class: "btn btn-link ps-0" do %>
    <i class="bi bi-arrow-left me-1"></i>Back to Personal Projects
  <% end %>
</p>
