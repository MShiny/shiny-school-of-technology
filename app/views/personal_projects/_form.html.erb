<%= form_with model: personal_project, class: "form-card" do |form| %>
  <%= render "shared/form_errors", object: personal_project %>

  <div class="form-section">
    <p class="form-section-title">Basics</p>
    <div class="mb-3">
      <%= form.label :name, class: "form-label" %>
      <%= form.text_field :name, class: "form-control", placeholder: "e.g. LMS RAG Project" %>
    </div>

    <div class="mb-3">
      <%= form.label :goal, class: "form-label" %>
      <%= form.text_area :goal, class: "form-control", rows: 2, placeholder: "What do you ultimately want to achieve?" %>
    </div>

    <div>
      <%= form.label :description, class: "form-label" %>
      <%= form.text_area :description, class: "form-control", rows: 3 %>
    </div>
  </div>

  <div class="form-section">
    <p class="form-section-title">Status &amp; Timing</p>
    <div class="row">
      <div class="col-md-6 mb-3 mb-md-0">
        <%= form.label :status, class: "form-label" %>
        <%= form.select :status, PersonalProject.statuses.keys.map { |s| [ s.humanize, s ] }, {}, class: "form-select" %>
      </div>
      <div class="col-md-6">
        <%= form.label :target_date, class: "form-label" %>
        <%= form.date_field :target_date, class: "form-control" %>
      </div>
    </div>

    <div class="mt-3">
      <%= form.label :notes, class: "form-label" %>
      <%= form.text_area :notes, class: "form-control", rows: 2 %>
    </div>
  </div>

  <div class="form-section">
    <p class="form-section-title">Subjects</p>
    <div class="row row-cols-2 row-cols-md-3 g-2 border rounded-3 p-3">
      <%= form.collection_check_boxes :subject_ids, Subject.ordered, :id, :name do |b| %>
        <div class="col form-check">
          <%= b.check_box(class: "form-check-input") %>
          <%= b.label(class: "form-check-label") %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="d-flex gap-2 mt-4">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", (personal_project.persisted? ? personal_project : personal_projects_path), class: "btn btn-outline-secondary" %>
  </div>
<% end %>
