<% content_for :title, "Subjects" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">📚 Subjects</h1>
  <%= link_to "New Subject", new_subject_path, class: "btn btn-primary" %>
</div>

<% if @subjects.any? %>
  <div class="row g-3">
    <% @subjects.each do |subject| %>
      <div class="col-md-6 col-lg-4">
        <div class="card h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
              <h2 class="card-title h5"><%= link_to subject.name, subject, class: "text-decoration-none" %></h2>
              <%= status_badge(subject.status) %>
            </div>
            <p class="card-text text-muted small"><%= truncate(subject.description, length: 100) if subject.description.present? %></p>
            <p class="card-text small">
              <% subject.degrees.each do |degree| %>
                <span class="badge text-bg-light border me-1"><%= degree.name %></span>
              <% end %>
            </p>
          </div>
          <div class="card-footer bg-transparent border-0 d-flex gap-2">
            <%= link_to "View", subject, class: "btn btn-sm btn-outline-primary" %>
            <%= link_to "Edit", edit_subject_path(subject), class: "btn btn-sm btn-outline-secondary" %>
            <%= button_to "Delete", subject, method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: "Delete this subject?" } } %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-muted">No subjects yet. Create one to start tracking your learning.</p>
<% end %>
