<% content_for :title, @subject.name %>

<div class="page-header">
  <div>
    <p class="page-eyebrow">Subject</p>
    <h1 class="h2 mb-2"><%= @subject.name %></h1>
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <%= status_badge(@subject.status) %>
      <% @degrees.each do |degree| %>
        <%= link_to degree.name, degree, class: "badge text-bg-light border text-decoration-none" %>
      <% end %>
    </div>
  </div>
  <div class="d-flex gap-2">
    <%= link_to new_course_path(subject_id: @subject.id), class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg me-1"></i>Add Course
    <% end %>
    <%= link_to edit_subject_path(@subject), class: "btn btn-outline-secondary" do %>
      <i class="bi bi-pencil"></i>
    <% end %>
    <%= button_to @subject, method: :delete, class: "btn btn-outline-danger", form: { data: { turbo_confirm: "Delete this subject?" } } do %>
      <i class="bi bi-trash3"></i>
    <% end %>
  </div>
</div>

<% if @subject.description.present? %>
  <p class="text-muted"><%= @subject.description %></p>
<% end %>

<% if @subject.notes.present? %>
  <div class="alert alert-light border">
    <strong>Notes:</strong> <%= @subject.notes %>
  </div>
<% end %>

<div class="section-heading mt-4">
  <h2><i class="bi bi-signpost-split text-muted"></i> Learning Roadmap</h2>
</div>

<% if @current_courses.any? || @next_up_courses.any? || @completed_courses.any? %>
  <div class="roadmap-timeline">
    <% if @completed_courses.any? %>
      <p class="roadmap-section-label">Completed</p>
      <% @completed_courses.each do |course| %>
        <div class="roadmap-step is-completed">
          <div class="roadmap-step-marker"><i class="bi bi-check-lg"></i></div>
          <div class="roadmap-step-card">
            <div class="d-flex justify-content-between align-items-start gap-2">
              <div>
                <%= link_to course.title, course, class: "text-decoration-none fw-semibold text-body" %>
                <div class="small text-muted">
                  <% if course.provider.present? %><%= course.provider %><% end %>
                  <% if course.level.present? %> · Level <%= course.level %><% end %>
                </div>
                <% if course.purpose.present? %>
                  <div class="small text-muted mt-1"><i class="bi bi-bullseye me-1"></i><%= course.purpose %></div>
                <% end %>
              </div>
              <%= status_badge(course.status) %>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>

    <% if @current_courses.any? %>
      <p class="roadmap-section-label">Current</p>
      <% @current_courses.each do |course| %>
        <div class="roadmap-step is-current">
          <div class="roadmap-step-marker"><i class="bi bi-play-fill"></i></div>
          <div class="roadmap-step-card">
            <div class="d-flex justify-content-between align-items-start gap-2">
              <div>
                <%= link_to course.title, course, class: "text-decoration-none fw-semibold text-body" %>
                <div class="small text-muted">
                  <% if course.provider.present? %><%= course.provider %><% end %>
                  <% if course.level.present? %> · Level <%= course.level %><% end %>
                  <% if course.roadmap_position.present? %> · Step <%= course.roadmap_position %><% end %>
                </div>
                <% if course.purpose.present? %>
                  <div class="small text-muted mt-1"><i class="bi bi-bullseye me-1"></i><%= course.purpose %></div>
                <% end %>
              </div>
              <%= status_badge(course.status) %>
            </div>
            <% if course.progress_percentage.present? %>
              <div class="progress mt-2" style="height: 6px;">
                <div class="progress-bar" role="progressbar" style="width: <%= course.progress_percentage %>%;"></div>
              </div>
              <p class="small text-muted mt-1 mb-0"><%= course.progress_percentage %>% complete</p>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>

    <% if @next_up_courses.any? %>
      <p class="roadmap-section-label">Next Up</p>
      <% @next_up_courses.each do |course| %>
        <div class="roadmap-step is-next">
          <div class="roadmap-step-marker"><%= course.roadmap_position.presence || "•" %></div>
          <div class="roadmap-step-card">
            <div class="d-flex justify-content-between align-items-start gap-2">
              <div>
                <%= link_to course.title, course, class: "text-decoration-none fw-semibold text-body" %>
                <div class="small text-muted">
                  <% if course.provider.present? %><%= course.provider %><% end %>
                  <% if course.level.present? %> · Level <%= course.level %><% end %>
                </div>
                <% if course.purpose.present? %>
                  <div class="small text-muted mt-1"><i class="bi bi-bullseye me-1"></i><%= course.purpose %></div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="empty-state">
    <i class="bi bi-signpost-split empty-state-icon"></i>
    Nothing queued yet.
  </div>
<% end %>

<% if @other_courses.any? %>
  <p class="roadmap-section-label mt-4">Other Courses</p>
  <div class="vstack gap-2 mb-3">
    <% @other_courses.each do |course| %>
      <%= link_to course_path(course), class: "journal-row text-decoration-none text-body" do %>
        <span>
          <span class="fw-semibold"><%= course.title %></span>
          <span class="text-muted small">
            <% if course.provider.present? %> · <%= course.provider %><% end %>
            <% if course.level.present? %> · Level <%= course.level %><% end %>
          </span>
        </span>
        <%= status_badge(course.status) %>
      <% end %>
    <% end %>
  </div>
<% end %>

<% if @personal_projects.any? %>
  <div class="section-heading mt-4">
    <h2 class="text-muted h6"><i class="bi bi-rocket-takeoff"></i> Related Personal Projects</h2>
  </div>
  <div class="row g-2 mb-3">
    <% @personal_projects.each do |project| %>
      <div class="col-md-6">
        <%= link_to project, class: "card project-card text-decoration-none text-body" do %>
          <div class="card-body py-2 d-flex justify-content-between align-items-center">
            <span class="fw-semibold small"><%= project.name %></span>
            <%= status_badge(project.status) %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<p class="mt-4">
  <%= link_to subjects_path, class: "btn btn-link ps-0" do %>
    <i class="bi bi-arrow-left me-1"></i>Back to Subjects
  <% end %>
</p>
