<header class="app-topbar d-flex d-lg-none">
  <button class="topbar-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNav" aria-controls="mobileNav" aria-label="Toggle navigation">
    <i class="bi bi-list fs-4"></i>
  </button>
  <%= link_to root_path, class: "text-decoration-none text-white d-flex align-items-center gap-2" do %>
    <span>🎓</span>
    <span class="fw-bold small">Shiny School of Technology</span>
  <% end %>
</header>

<div class="offcanvas offcanvas-start text-bg-dark" tabindex="-1" id="mobileNav" aria-labelledby="mobileNavLabel">
  <div class="offcanvas-header">
    <span class="fw-bold" id="mobileNavLabel">🎓 Shiny School</span>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body">
    <%= render "layouts/nav_links" %>
  </div>
</div>
