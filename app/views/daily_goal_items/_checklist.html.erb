<%
editable = local_assigns.fetch(:editable, false)
items = daily_goal.daily_goal_items.to_a
total = items.size
completed = items.count(&:completed?)
percentage = total.zero? ? 0 : ((completed.to_f / total) * 100).round
%>

<div class="checklist">
  <% if items.any? %>
    <div class="checklist-list mb-1">
      <% items.each do |item| %>
        <div class="checklist-item <%= item.completed? ? 'is-complete' : 'is-incomplete' %>">
          <% if editable %>
            <%= button_to toggle_daily_goal_item_path(item), method: :patch, class: "checklist-toggle #{'is-complete' if item.completed?}", form: { class: "mb-0" }, aria: { label: item.completed? ? "Mark as not done" : "Mark as done" } do %>
              <i class="bi bi-check-lg"></i>
            <% end %>
            <%= form_with model: item, url: daily_goal_item_path(item), method: :patch, class: "checklist-item-text d-flex gap-1 mb-0" do |f| %>
              <%= f.text_field :text, class: "form-control form-control-sm border-0 bg-transparent px-1", "aria-label": "Item text" %>
              <%= f.button type: "submit", class: "btn btn-sm btn-outline-primary flex-shrink-0", aria: { label: "Save item" } do %>
                <i class="bi bi-check-lg"></i>
              <% end %>
            <% end %>
            <%= button_to daily_goal_item_path(item), method: :delete, class: "btn btn-sm btn-outline-danger border-0", form: { class: "mb-0", data: { turbo_confirm: "Remove this item?" } }, aria: { label: "Remove item" } do %>
              <i class="bi bi-x-lg"></i>
            <% end %>
          <% else %>
            <span class="checklist-item-static-mark"><i class="bi <%= item.completed? ? 'bi-check-circle-fill' : 'bi-circle' %>"></i></span>
            <span class="checklist-item-text"><%= item.text %></span>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="checklist-progress-summary">
      <div class="progress" role="progressbar" aria-valuenow="<%= percentage %>" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar bg-success" style="width: <%= percentage %>%;"></div>
      </div>
      <span class="progress-count"><%= completed %> / <%= total %> completed</span>
    </div>
  <% else %>
    <div class="empty-state empty-state-inline mb-0">No checklist items for this day.</div>
  <% end %>

  <% if editable %>
    <%= form_with url: daily_goal_items_path, method: :post, class: "checklist-add-form" do %>
      <%= hidden_field_tag "daily_goal_item[daily_goal_id]", daily_goal.id %>
      <%= text_field_tag "daily_goal_item[text]", nil, class: "form-control form-control-sm", placeholder: "Add an item...", required: true %>
      <%= submit_tag "Add", class: "btn btn-sm btn-primary flex-shrink-0" %>
    <% end %>
  <% end %>
</div>
