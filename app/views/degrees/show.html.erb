<% content_for :title, @degree.name %>

<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <h1 class="h3 mb-1"><%= @degree.name %></h1>
    <%= status_badge(@degree.status) %>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Edit", edit_degree_path(@degree), class: "btn btn-outline-secondary" %>
    <%= button_to "Delete", @degree, method: :delete, class: "btn btn-outline-danger", form: { data: { turbo_confirm: "Delete this degree?" } } %>
  </div>
</div>

<% if @degree.description.present? %>
  <p class="lead"><%= @degree.description %></p>
<% end %>

<h2 class="h5 mt-4">Subjects</h2>
<% if @subjects.any? %>
  <div class="row g-2">
    <% @subjects.each do |subject| %>
      <div class="col-md-6 col-lg-4">
        <div class="card">
          <div class="card-body d-flex justify-content-between align-items-center">
            <%= link_to subject.name, subject, class: "text-decoration-none fw-semibold" %>
            <%= status_badge(subject.status) %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-muted">No subjects linked to this degree yet.</p>
<% end %>

<p class="mt-3">
  <%= link_to "← Back to Degrees", degrees_path, class: "btn btn-link ps-0" %>
</p>
