<% content_for :title, @degree.name %>

<div class="page-header">
  <div>
    <p class="page-eyebrow">Degree</p>
    <h1 class="h2 mb-2"><%= @degree.name %></h1>
    <%= status_badge(@degree.status) %>
  </div>
  <div class="d-flex gap-2">
    <%= link_to edit_degree_path(@degree), class: "btn btn-outline-secondary" do %>
      <i class="bi bi-pencil me-1"></i>Edit
    <% end %>
    <%= button_to @degree, method: :delete, class: "btn btn-outline-danger", form: { data: { turbo_confirm: "Delete this degree?" } } do %>
      <i class="bi bi-trash3 me-1"></i>Delete
    <% end %>
  </div>
</div>

<% if @degree.description.present? %>
  <p class="text-muted mb-4"><%= @degree.description %></p>
<% end %>

<div class="section-heading">
  <h2><i class="bi bi-journal-bookmark text-muted"></i> Curriculum</h2>
</div>
<% if @subjects.any? %>
  <div class="row g-2 mb-3">
    <% @subjects.each do |subject| %>
      <div class="col-md-6 col-lg-4">
        <%= link_to subject, class: "card h-100 text-decoration-none text-body" do %>
          <div class="card-body py-3">
            <div class="d-flex justify-content-between align-items-center">
              <span class="fw-semibold"><%= subject.name %></span>
              <%= status_badge(subject.status) %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="empty-state empty-state-inline">No subjects linked to this degree yet.</div>
<% end %>

<p class="mt-4">
  <%= link_to degrees_path, class: "btn btn-link ps-0" do %>
    <i class="bi bi-arrow-left me-1"></i>Back to Degrees
  <% end %>
</p>
