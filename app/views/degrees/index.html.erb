<% content_for :title, "Degrees" %>

<div class="page-header">
  <div>
    <p class="page-eyebrow">Curriculum</p>
    <h1 class="h2">Degrees</h1>
  </div>
  <%= link_to new_degree_path, class: "btn btn-primary" do %>
    <i class="bi bi-plus-lg me-1"></i>Add Degree
  <% end %>
</div>

<% if @degrees.any? %>
  <div class="row g-3">
    <% @degrees.each do |degree| %>
      <div class="col-md-6 col-lg-4">
        <div class="card h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
              <h2 class="card-title h6 mb-1"><%= link_to degree.name, degree, class: "text-decoration-none text-body" %></h2>
              <%= status_badge(degree.status) %>
            </div>
            <p class="card-text small text-muted mb-2">
              <i class="bi bi-journal-bookmark me-1"></i><%= pluralize(degree.subjects.size, "subject") %>
            </p>
            <% if degree.description.present? %>
              <p class="card-text small text-muted mb-0"><%= truncate(degree.description, length: 100) %></p>
            <% end %>
          </div>
          <div class="card-footer bg-transparent border-top-0 pt-0 d-flex gap-2">
            <%= link_to "View", degree, class: "btn btn-sm btn-outline-secondary" %>
            <%= link_to "Edit", edit_degree_path(degree), class: "btn btn-sm btn-outline-secondary" %>
            <%= button_to degree, method: :delete, class: "btn btn-sm btn-outline-danger ms-auto", form: { data: { turbo_confirm: "Delete this degree?" } } do %>
              <i class="bi bi-trash3"></i>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="empty-state">
    <i class="bi bi-mortarboard empty-state-icon"></i>
    No degrees yet. Create your first self-directed degree to get started.
  </div>
<% end %>
