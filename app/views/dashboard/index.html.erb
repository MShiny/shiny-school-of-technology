<% content_for :title, "Dashboard" %>

<div class="card todays-goal-card mb-4">
  <div class="card-body p-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
      <div>
        <p class="text-muted mb-1 small text-uppercase fw-semibold">Today · <%= @todays_goal.date.strftime("%A, %B %-d, %Y") %></p>
        <h1 class="h3 mb-2">🎯 Today's Checklist</h1>
        <%= status_badge(@todays_goal.status) %>
      </div>
      <%= link_to "Edit notes", edit_daily_goal_path(@todays_goal), class: "btn btn-outline-secondary btn-sm" %>
    </div>

    <%= render "daily_goal_items/checklist", daily_goal: @todays_goal, editable: true %>

    <p class="mb-0 mt-2">
      <%= link_to "View full day →", daily_goal_path(@todays_goal), class: "small" %>
    </p>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="stat-value text-success"><%= @monthly_stats[:met] %></div>
        <div class="text-muted small">Met this month</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="stat-value"><%= @monthly_stats[:total] %></div>
        <div class="text-muted small">Total goals this month</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="stat-value text-primary"><%= @monthly_stats[:completion_percentage] %>%</div>
        <div class="text-muted small">Completion rate</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="stat-value text-warning"><span class="streak-flame">🔥</span> <%= @current_streak %></div>
        <div class="text-muted small">Current streak</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="stat-value text-info"><%= @monthly_stats[:completed_items] %> / <%= @monthly_stats[:total_items] %></div>
        <div class="text-muted small">Checklist items this month (<%= @monthly_stats[:item_completion_percentage] %>%)</div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-6">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h2 class="h5 mb-0">🏛️ Active Degrees</h2>
      <%= link_to "View all", degrees_path, class: "small" %>
    </div>
    <% if @active_degrees.any? %>
      <div class="vstack gap-2">
        <% @active_degrees.each do |degree| %>
          <div class="card">
            <div class="card-body d-flex justify-content-between align-items-center">
              <%= link_to degree.name, degree, class: "text-decoration-none fw-semibold" %>
              <span class="text-muted small"><%= pluralize(degree.subjects.size, "subject") %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-muted small">No active degrees right now.</p>
    <% end %>
  </div>

  <div class="col-lg-6">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h2 class="h5 mb-0">🧑‍💻 Current Studies</h2>
      <%= link_to "View all", courses_path, class: "small" %>
    </div>
    <% if @current_courses.any? %>
      <div class="vstack gap-2">
        <% @current_courses.each do |course| %>
          <div class="card">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <%= link_to course.title, course, class: "text-decoration-none fw-semibold" %>
                  <div class="small text-muted">
                    <%= link_to course.subject.name, course.subject, class: "text-decoration-none" %>
                    <% if course.provider.present? %> · <%= course.provider %><% end %>
                    <% if course.level.present? %> · Level <%= course.level %><% end %>
                  </div>
                  <% if course.purpose.present? %>
                    <div class="small text-muted"><em>🎯 <%= course.purpose %></em></div>
                  <% end %>
                </div>
                <% if course.progress_percentage.present? %>
                  <span class="badge text-bg-info"><%= course.progress_percentage %>%</span>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-muted small">Nothing in progress right now.</p>
    <% end %>
  </div>
</div>

<div class="mt-4">
  <div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="h5 mb-0">📈 Recent Goals</h2>
    <%= link_to "View all", daily_goals_path, class: "small" %>
  </div>
  <% if @recent_goals.any? %>
    <div class="list-group">
      <% @recent_goals.each do |goal| %>
        <%= link_to daily_goal_path(goal), class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>
          <span>
            <strong><%= goal.date.strftime("%b %-d") %></strong>
            <span class="text-muted ms-2"><%= goal.items_completed_count %> / <%= goal.items_total %> completed</span>
          </span>
          <%= status_badge(goal.status) %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="text-muted small">No goal history yet.</p>
  <% end %>
</div>

<div class="mt-4">
  <div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="h5 mb-0">🚀 Personal Projects</h2>
    <%= link_to "View all", personal_projects_path, class: "small" %>
  </div>
  <% if @personal_projects.any? %>
    <div class="row g-2">
      <% @personal_projects.each do |project| %>
        <div class="col-md-6">
          <div class="card h-100">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start">
                <%= link_to project.name, project, class: "text-decoration-none fw-semibold" %>
                <%= status_badge(project.status) %>
              </div>
              <% if project.goal.present? %>
                <p class="small text-muted mb-1"><%= truncate(project.goal, length: 90) %></p>
              <% end %>
              <% if project.target_date.present? %>
                <p class="small text-muted mb-1">🎯 Target: <%= project.target_date.strftime("%b %-d, %Y") %></p>
              <% end %>
              <% if project.subjects.any? %>
                <p class="mb-0">
                  <% project.subjects.each do |subject| %>
                    <span class="badge text-bg-light border me-1"><%= subject.name %></span>
                  <% end %>
                </p>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-muted small">No active or planned personal projects right now.</p>
  <% end %>
</div>
