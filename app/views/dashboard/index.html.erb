<% content_for :title, "Dashboard" %>

<div class="page-header">
  <div>
    <p class="page-eyebrow"><%= Date.current.strftime("%A, %B %-d") %></p>
    <h1 class="h2"><%= time_based_greeting %>, Shiny</h1>
    <p class="text-muted mb-0">Here's your learning plan for today.</p>
  </div>
</div>

<div class="hero-card p-4 p-md-4 mb-4">
  <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
      <p class="text-muted mb-1 small text-uppercase fw-semibold">Today's Checklist</p>
      <h2 class="h4 mb-2"><%= @todays_goal.date.strftime("%A, %B %-d, %Y") %></h2>
      <%= status_badge(@todays_goal.status) %>
    </div>
    <%= link_to edit_daily_goal_path(@todays_goal), class: "btn btn-outline-secondary btn-sm" do %>
      <i class="bi bi-pencil me-1"></i>Edit notes
    <% end %>
  </div>

  <%= render "daily_goal_items/checklist", daily_goal: @todays_goal, editable: true %>

  <p class="mb-0 mt-3">
    <%= link_to daily_goal_path(@todays_goal), class: "small fw-semibold" do %>
      View full day <i class="bi bi-arrow-right"></i>
    <% end %>
  </p>
</div>

<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="stat-icon" style="background: var(--color-warning-soft); color: var(--color-warning);"><i class="bi bi-fire"></i></div>
        <div class="stat-value"><%= @current_streak %></div>
        <div class="stat-label">Day streak</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="stat-icon" style="background: var(--color-accent-soft); color: var(--color-accent);"><i class="bi bi-graph-up"></i></div>
        <div class="stat-value"><%= @monthly_stats[:completion_percentage] %>%</div>
        <div class="stat-label">Monthly completion</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="stat-icon" style="background: var(--color-success-soft); color: var(--color-success);"><i class="bi bi-check2-circle"></i></div>
        <div class="stat-value"><%= @monthly_stats[:completed_items] %> / <%= @monthly_stats[:total_items] %></div>
        <div class="stat-label">Items completed this month (<%= @monthly_stats[:item_completion_percentage] %>%)</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="stat-icon" style="background: var(--color-info-soft); color: var(--color-info);"><i class="bi bi-laptop"></i></div>
        <div class="stat-value"><%= @current_courses.size %></div>
        <div class="stat-label">Active courses</div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-7">
    <div class="section-heading">
      <h2><i class="bi bi-mortarboard text-muted"></i> Current Studies</h2>
      <%= link_to "View all", courses_path, class: "small fw-semibold" %>
    </div>
    <% if @current_courses.any? %>
      <div class="vstack gap-2">
        <% @current_courses.each do |course| %>
          <div class="card course-card status-<%= course.status %>">
            <div class="card-body py-3">
              <div class="d-flex justify-content-between align-items-start gap-2">
                <div class="min-w-0">
                  <%= link_to course.title, course, class: "text-decoration-none fw-semibold text-body" %>
                  <div class="small text-muted">
                    <%= link_to course.subject.name, course.subject, class: "text-decoration-none text-muted" %>
                    <% if course.level.present? %> · Level <%= course.level %><% end %>
                    <% if course.provider.present? %> · <%= course.provider %><% end %>
                  </div>
                  <% if course.purpose.present? %>
                    <div class="small text-muted mt-1"><i class="bi bi-bullseye me-1"></i><%= course.purpose %></div>
                  <% end %>
                </div>
                <% if course.progress_percentage.present? %>
                  <span class="badge text-bg-light border flex-shrink-0"><%= course.progress_percentage %>%</span>
                <% end %>
              </div>
              <% if course.progress_percentage.present? %>
                <div class="progress mt-2" style="height: 5px;">
                  <div class="progress-bar" role="progressbar" style="width: <%= course.progress_percentage %>%;"></div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state empty-state-inline">Nothing in progress right now.</div>
    <% end %>

    <div class="section-heading mt-4">
      <h2><i class="bi bi-mortarboard-fill text-muted"></i> Active Degrees</h2>
      <%= link_to "View all", degrees_path, class: "small fw-semibold" %>
    </div>
    <% if @active_degrees.any? %>
      <div class="row g-2">
        <% @active_degrees.each do |degree| %>
          <div class="col-sm-6">
            <div class="card h-100">
              <div class="card-body py-3 d-flex justify-content-between align-items-center">
                <%= link_to degree.name, degree, class: "text-decoration-none fw-semibold text-body" %>
                <span class="text-muted small"><%= pluralize(degree.subjects.size, "subject") %></span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state empty-state-inline">No active degrees right now.</div>
    <% end %>
  </div>

  <div class="col-lg-5">
    <div class="section-heading">
      <h2><i class="bi bi-rocket-takeoff text-muted"></i> Personal Projects</h2>
      <%= link_to "View all", personal_projects_path, class: "small fw-semibold" %>
    </div>
    <% if @personal_projects.any? %>
      <div class="vstack gap-2">
        <% @personal_projects.each do |project| %>
          <div class="card project-card">
            <div class="card-body py-3">
              <div class="d-flex justify-content-between align-items-start gap-2">
                <%= link_to project.name, project, class: "text-decoration-none fw-semibold text-body" %>
                <%= status_badge(project.status) %>
              </div>
              <% if project.goal.present? %>
                <p class="small text-muted mb-1 mt-1"><%= truncate(project.goal, length: 80) %></p>
              <% end %>
              <div class="d-flex flex-wrap align-items-center gap-2 mt-1">
                <% if project.target_date.present? %>
                  <span class="small text-muted"><i class="bi bi-flag me-1"></i><%= project.target_date.strftime("%b %-d, %Y") %></span>
                <% end %>
                <% project.subjects.each do |subject| %>
                  <span class="badge text-bg-light border"><%= subject.name %></span>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state empty-state-inline">No active projects right now.</div>
    <% end %>

    <div class="section-heading mt-4">
      <h2><i class="bi bi-clock-history text-muted"></i> Recent Activity</h2>
      <%= link_to "View all", history_daily_goals_path, class: "small fw-semibold" %>
    </div>
    <% if @recent_goals.any? %>
      <div class="vstack gap-2">
        <% @recent_goals.each do |goal| %>
          <%= link_to daily_goal_path(goal), class: "journal-row text-decoration-none text-body py-2 px-3" do %>
            <span class="d-flex align-items-center gap-2">
              <%= status_dot(goal.status) %>
              <span class="small fw-semibold"><%= goal.date.strftime("%b %-d") %></span>
            </span>
            <span class="small text-muted"><%= goal.items_completed_count %> / <%= goal.items_total %></span>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state empty-state-inline">No goal history yet.</div>
    <% end %>
  </div>
</div>
